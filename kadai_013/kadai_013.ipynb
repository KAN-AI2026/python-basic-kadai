      "source": [
        "# 消費税込み金額を計算する\n",
        "def calc_tax_included(price: int, tax_rate: int) -> float:\n",
        "    # 税込価格 = 本体価格 × (1 + 税率 ÷ 100)\n",
        "    tax_included = price * (1 + tax_rate / 100)\n",
        "    return tax_included\n",
        "\n",
        "\n",
        "# 呼び出し：第1引数 110、第2引数 10\n",
        "result = calc_tax_included(110, 10)\n",
        "print(result)\n"
      ]
    }
  ]
}